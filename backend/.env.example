#Your PostgreSQL connection string (e.g., postgresql://user:password@host:port/database?schema=public).
# Conexión normal (usada en runtime → backend en producción) en Supabase "Transaction Pooler"
DATABASE_URL=

# Conexión directa (usada en migraciones → Render build o local dev) en supabase "Direct Connection"
DIRECT_DATABASE_URL=

JWT_SECRET= #A secure secret string to sign JWT tokens (minimum 32 characters).
COOKIE_SECRET= #A secure secret string used to sign HTTP-only cookies (fallbacks to JWT_SECRET if unset).

# ============================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ============================================
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID= #Your Google Cloud Client ID for OAuth 2.0 (e.g., 123456789-abc...apps.googleusercontent.com).

GOOGLE_CLIENT_SECRET= #Your Google Cloud Client Secret (e.g., GOCSPX-...).

# URL de tu API backend (usada para generar callback URL de Google OAuth)
# En desarrollo: http://localhost:5000/api
# En producción: https://api.tudominio.com/api
API_URL= #The base URL of your backend API (required for Google OAuth callback).
# ============================================

PORT=  #The port where the apis is running (e.g., 5000).

CLIENT_URL= #The base URL of your frontend (e.g., "http://localhost:5173"). Used for CORS, sitemap.xml generation, and OAuth redirects.

LOG_LEVEL=  #'info' es el valor por deafult, Moficia el nivel de detalle de los log de pino

ADMIN_EMAIL= #Email del admin de la app

ADMIN_PASSWORD= #Password del admin de la app

NODE_ENV='development' # El entorno en el que se está ejecutando la aplicación (e.g., "development", "production")

# ============================================
# EMAIL CONFIGURATION (RESEND)
# ============================================
# Obtén tu API key en: https://resend.com/api-keys
# En desarrollo: puedes usar dominio sandbox (onboarding@resend.dev)
# En producción: debes verificar tu dominio propio
RESEND_API_KEY= #Your Resend API key (e.g., re_...)

# Email "from" para todos los emails transaccionales
# En desarrollo con sandbox: onboarding@resend.dev
# En producción: noreply@tudominio.com (requiere dominio verificado)
RESEND_FROM_EMAIL=no-reply@appointmepro.me
# Set to 'true' to skip Resend and log transactional emails to console (development only).
MOCK_EMAILS=false
# ============================================

# ============================================
# RATE LIMITING (UPSTASH REDIS)
# ============================================
# Obtén estas credenciales en: https://console.upstash.com/
# Plan gratuito: 10,000 comandos/día
# Si no se configuran (o NODE_ENV=development), el rate limit es fail-open
# y todas las solicitudes pasan sin restricción.
UPSTASH_REDIS_REST_URL= #Your Upstash Redis REST URL (e.g., https://xxx.upstash.io).
UPSTASH_REDIS_REST_TOKEN= #Your Upstash Redis REST token.

# Set to 'true' to disable rate limiting entirely (emergency switch)
RATE_LIMIT_DISABLED=false
# ============================================

# Notas sobre valores de LOG_LEVEL para pino:
# trace: Para el seguimiento más detallado y verboso posible.
# debug: Para información de depuración que solo es útil para los desarrolladores.
# info: Para eventos importantes pero normales en el flujo de la aplicación (ej. "Servidor iniciado", "Usuario registrado").
# warn: Para advertencias sobre eventos que no son un error, pero que son inesperados o podrían indicar un problema futuro (ej. "Intento de login fallido").
# error: Para errores que han ocurrido y han afectado la ejecución de una operación (ej. "No se pudo conectar a la base de datos").
# fatal: Para errores tan graves que la aplicación no puede continuar y debe cerrarse.