# Test environment for pnpm devTest
# Copy to backend/.env (append at the bottom) and fill in your local credentials.
# DO NOT commit a real .env — this file is the template only.

# Test database (separate from dev DB; never drop automatically).
# If unset, devTest.mjs derives it from DATABASE_URL by replacing the database
# name with "appointme_test". Set this only if your test DB has different
# credentials (host, user, password) than the dev DB.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointme_test?schema=public

# Suppress all transactional emails. The booking/registro is still successful,
# but no real email is sent to Resend. Saves the production Resend quota during
# local test runs. The orchestrator sets this automatically.
MOCK_EMAILS=true

# Disable rate limiting in tests for speed and determinism.
RATE_LIMIT_DISABLED=true

# Client URL for OAuth callbacks (not used in booking-flow spec but required by config).
CLIENT_URL=http://localhost:5173
