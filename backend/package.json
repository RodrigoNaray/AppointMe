{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts | pino-pretty",
    "predev": "pnpm prisma:generate",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "pnpm clean && tsc && pnpm prisma:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:strict": "pnpm lint",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "prisma generate --schema=./src/prisma/schema.prisma",
    "prisma:migrate:reset": "prisma migrate reset --schema=./src/prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=./src/prisma/schema.prisma",
    "create:admin": "ts-node ./scripts/create-first-admin.ts",
    "db:seed": "prisma db seed --schema=./src/prisma/schema.prisma",
    "verify:google-oauth": "node verify-google-oauth.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.11.0",
    "resend": "^6.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "globals": "^16.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "node dist/src/prisma/seed.js"
  }
}
