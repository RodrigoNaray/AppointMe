{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts | pino-pretty",
    "predev": "pnpm prisma:generate",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "pnpm clean && tsc && pnpm prisma:generate",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "prisma generate --schema=./src/prisma/schema.prisma",
    "prisma:migrate:reset": "prisma migrate reset --schema=./src/prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=./src/prisma/schema.prisma",
    "create:admin": "ts-node ./scripts/create-first-admin.ts",
    "db:seed": "prisma db seed --schema=./src/prisma/schema.prisma",
    "verify:google-oauth": "node verify-google-oauth.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.2.0",
    "resend": "^6.4.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "pino-pretty": "^11.2.1",
    "prisma": "^5.15.0",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "node dist/prisma/seed.js"
  }
}
