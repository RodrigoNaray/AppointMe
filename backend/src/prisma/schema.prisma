// Este es tu archivo de esquema de Prisma,
// aprende más sobre él en la documentación: https://pris.ly/d/prisma-schema

// Define cómo se genera el cliente Prisma que usarás en tu código backend.
generator client {
  provider = "prisma-client-js"
}

// Define la fuente de datos, en este caso, PostgreSQL.
// La URL de conexión se toma de la variable de entorno DATABASE_URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Enum para el estado de las reservas
enum BookingStatus {
  CONFIRMED  // Reserva activa (default al crear)
  CANCELLED  // Reserva cancelada por el usuario (soft delete)
}

enum CancellationReason {
  CANCELLED_BY_CLIENT
  CANCELLED_BY_ADMIN
  CANCELLED_BY_ADMIN_RESCHEDULE
}

// Modelo para el Administrador (el profesional que usa la app)
model AdminUser {
  id            String    @id @default(cuid()) // Clave primaria, generada automáticamente
  email         String    @unique             // Email único para el login
  passwordHash  String?                       // Hash de la contraseña (opcional si solo usa Google Login)
  googleId      String?   @unique             // ID de Google para el login social (opcional y único)

  // Configuraciones específicas del administrador
  schedule      Json?     // Horario base semanal, almacenado como JSON. Ejemplo:
                          // { "monday": { "start": "09:00", "end": "18:00", "isActive": true }, ... }
  minBookingAdvanceMinutes Int? @default(60)   // Antelación mínima para reservas, en minutos. Por defecto 1 hora.
  minCancellationNoticeMinutes Int? @default(120) // Tiempo mínimo antes de cita para permitir cancelación (2 horas)

  // Información de contacto pública del negocio
  businessPhone   String?   // Teléfono de contacto del negocio (público en HomePage/ContactPage)
  businessEmail   String?   // Email de contacto del negocio (diferente del email de login)
  businessAddress String?   // Dirección física del negocio
  businessLatitude  Float?  // Latitud de la ubicación del negocio (rango: -90 a 90, precisión 6 decimales ~10cm)
  businessLongitude Float?  // Longitud de la ubicación del negocio (rango: -180 a 180)

  services          Service[]
  bookings          Booking[]
  availabilityBlocks AvailabilityBlock[]

  createdAt     DateTime  @default(now())     // Fecha y hora de creación del registro
  updatedAt     DateTime  @updatedAt          // Fecha y hora de la última actualización
}

// Modelo para los Clientes que reservan
model Client {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  emailLanguage String @default("es")
  passwordHash String?   // Opcional para el login con Google
  googleId     String?   @unique

  // Campos de verificación de email
  emailVerified Boolean @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?

  // Campos de cambio de email
  pendingEmail String?
  emailChangeToken String?
  emailChangeExpires DateTime?

  // Campos de recuperación de contraseña
  passwordResetToken String?
  passwordResetExpires DateTime?

  // Relación: Un cliente puede tener muchas reservas
  bookings     Booking[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([emailVerificationToken])
  @@index([emailChangeToken])
  @@index([passwordResetToken])
}

// Modelo para las Categorías de Servicios (globales para toda la plataforma)
model Category {
  id          String    @id @default(cuid())
  name        String    @unique // Nombre único global (ej: "Cortes", "Barba")
  description String?   // Descripción opcional de la categoría
  isActive    Boolean   @default(true) // Permitir desactivar categorías sin eliminarlas

  services    Service[] // Relación uno-a-muchos: Una categoría tiene muchos servicios

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Modelo para los Servicios ofrecidos
model Service {
  id            String    @id @default(cuid())
  name          String    @unique // <-- AÑADIDO: El nombre del servicio debe ser único
  description   String?
  durationMinutes Int
  price         Float
  isActive      Boolean   @default(true)

  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id])

  categoryId  String    // Relación con categoría
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([adminId])
  @@index([adminId, isActive])
}

// Modelo para las Reservas hechas por los clientes
model Booking {
  id                String              @id @default(cuid())
  bookingTime       DateTime
  durationMinutes   Int                 // Duración snapshot del servicio al momento de reservar
  status            BookingStatus       @default(CONFIRMED) // Estado de la reserva (CONFIRMED | CANCELLED)
  notes             String?             // Notas opcionales del cliente al reservar
  cancelledAt       DateTime?           // Timestamp del soft delete
  cancellationReason CancellationReason? // Origen de la cancelación (analytics/audit)

  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id])

  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingTime])
  @@index([status])
  @@index([adminId, status])
  @@index([clientId, bookingTime])
  @@unique([bookingTime, serviceId, clientId, adminId]) 
}

// Modelo para los Bloqueos de Disponibilidad definidos por el administrador
model AvailabilityBlock {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  reason    String?

  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime, endTime])
  @@index([adminId, startTime])
  @@unique([startTime, endTime, adminId]) 
}

