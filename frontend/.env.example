# URL base de la API del backend (debe empezar con VITE_ para ser expuesta al cliente)
# En desarrollo, usualmente apunta a tu servidor backend local.
# Se usa para todas las llamadas API incluyendo Google OAuth
# IMPORTANTE: NO incluir trailing slash (/) al final
# En produccion por ejemplo seria https://api.appointmepro.me
VITE_API_BASE_URL=http://localhost:5000/api

# Dominio público del sitio (usado para meta tags, SEO, etc)
# En desarrollo: http://localhost:5173
# En producción: https://appointmepro.me
# IMPORTANTE: Para clientes custom, cambiar este valor por su dominio propio
# Ejemplo para cliente: https://barberiapremiun.com
VITE_PUBLIC_DOMAIN=http://localhost:5173