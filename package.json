{
  "name": "appointmepro-launcher",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter backend test",
    "test:frontend": "pnpm --filter frontend test",
    "test:coverage": "pnpm --filter backend test:coverage && pnpm --filter frontend test:coverage"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.5.3"
  }
}
